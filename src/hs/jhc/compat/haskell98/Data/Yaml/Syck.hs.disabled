-- Compatibility stub for Data.Yaml.Syck (from HsSyck package)
-- This is a minimal stub to allow compilation when HsSyck is not available.
-- YAML library descriptor parsing is not supported in this configuration.
module Data.Yaml.Syck (
    YamlNode(..),
    YamlElem(..),
    parseYamlBytes,
    emitYaml,
    unpackBuf
    ) where

import qualified Data.ByteString as BS

data YamlNode = MkNode { n_elem :: YamlElem }

data YamlElem
    = EMap [(YamlNode, YamlNode)]
    | ESeq [YamlNode]
    | EStr YamlBuf
    | ENil

type YamlBuf = BS.ByteString

unpackBuf :: YamlBuf -> String
unpackBuf = map (toEnum . fromEnum) . BS.unpack

parseYamlBytes :: BS.ByteString -> IO YamlNode
parseYamlBytes _ = ioError $ userError "Data.Yaml.Syck: YAML parsing not supported (HsSyck package not available)"

emitYaml :: YamlNode -> IO String
emitYaml _ = ioError $ userError "Data.Yaml.Syck: YAML emission not supported (HsSyck package not available)"
